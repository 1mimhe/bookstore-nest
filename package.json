{
  "name": "bookstore-nest",
  "version": "1.0.0",
  "description": "A modular, event-driven bookstore and e-commerce REST API built with NestJS, TypeORM, MySQL, and Redis — featuring RBAC auth, atomic inventory management, Redis-backed sessions/caching, and a provider-agnostic payment flow.",
  "keywords": [
    "nestjs",
    "typeorm",
    "mysql",
    "redis",
    "typescript",
    "ecommerce",
    "bookstore",
    "rbac",
    "event-driven",
    "rest-api"
  ],
  "author": "Mohammad Hosseini",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json",
    "seed:languages": "node -r ts-node/register -r tsconfig-paths/register ./src/database/seeds/languages.seed.ts",
    "seed:tags": "node -r ts-node/register -r tsconfig-paths/register ./src/database/seeds/tags.seed.ts",
    "seed:admin": "node -r ts-node/register -r tsconfig-paths/register ./src/database/seeds/admin.seed.ts",
    "seed": "node -r ts-node/register -r tsconfig-paths/register ./src/database/seeds/master.seed.ts",
    "seed:users": "node -r ts-node/register -r tsconfig-paths/register ./src/database/seeds/master.seed.ts users",
    "seed:catalog": "node -r ts-node/register -r tsconfig-paths/register ./src/database/seeds/master.seed.ts catalog",
    "seed:content": "node -r ts-node/register -r tsconfig-paths/register ./src/database/seeds/master.seed.ts content",
    "seed:shop": "node -r ts-node/register -r tsconfig-paths/register ./src/database/seeds/master.seed.ts shop",
    "seed:activity": "node -r ts-node/register -r tsconfig-paths/register ./src/database/seeds/master.seed.ts activity",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts"
  },
  "dependencies": {
    "@2toad/profanity": "^3.1.1",
    "@keyv/redis": "^4.5.0",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/dotenv": "^6.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.7",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.7.0",
    "joi": "^17.13.8",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "redis": "^5.5.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "typeorm": {
      "redis": "^5.5.6"
    },
    "diff": "^4.0.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.16.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "modules/**/services/*.service.ts",
      "common/services/**/*.ts",
      "common/interceptors/**/*.ts",
      "common/filters/**/*.ts",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/*.entity.ts",
      "!**/*.seed.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
